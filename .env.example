# الوسيلة الذكية — Current Environment Contract
# Production hosting authority: Render. Do not restore legacy Supabase/Vercel envs here.

# -----------------------------
# Backend API — apps/api
# -----------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/alwaslh
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
SESSION_COOKIE_NAME=alwaslh_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
MEDIA_STORAGE_ROOT=./.media-storage

# -----------------------------
# Student/Admin Vite apps
# -----------------------------
VITE_API_BASE_URL=http://localhost:3000

# Production Render values are declared/wired in root render.yaml.
# Never commit database credentials, provider credentials, tokens, or private keys.
