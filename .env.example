# إعدادات Supabase للواجهة الأمامية
# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase Anon/Public API Key
VITE_SUPABASE_ANON_KEY=your-anon-key

# إعدادات Supabase لـ Edge Functions (Backend)
# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co
# Supabase Service Role Key (يُستخدم فقط في Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# مفتاح تشفير كلمات المرور (Edge Functions)
PASSWORD_ENCRYPTION_KEY=your-encryption-key

# مفتاح بوابة التكاملات (يوفره المنصة)
INTEGRATIONS_API_KEY=your-integrations-api-key
