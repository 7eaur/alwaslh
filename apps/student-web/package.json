{
  "name": "@alwaslh/student-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "prebuild": "npm run lint && npm test",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alwaslh/brand": "file:../../packages/brand",
    "@alwaslh/domain": "file:../../packages/domain",
    "@alwaslh/validation": "file:../../packages/validation",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.35.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
