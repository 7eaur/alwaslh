NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://alwaslh_app:change-me@127.0.0.1:5432/alwaslh
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
SESSION_COOKIE_NAME=alwaslh_session
